{
  "$schema": "https://schema.management.azure.com/schemas/2015-01-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "webAppName": {
      "value": "${{WEBAPP_NAME}}"
    },
    "planName": {
      "value": "${{APP_SERVICE_PLAN_NAME}}"
    },
    "location": {
      "value": "${{AZURE_LOCATION}}"
    },
    "botName": {
      "value": "${{BOT_SERVICE_NAME}}"
    },
    "botId": {
      "value": "${{BOT_ID}}"
    },
    "tenantId": {
      "value": "${{BOT_TENANT_ID}}"
    },
    "botPassword": {
      "value": "${{SECRET_BOT_PASSWORD}}"
    },
    "projectEndpoint": {
      "value": "${{PROJECT_ENDPOINT}}"
    },
    "modelDeploymentName": {
      "value": "${{MODEL_DEPLOYMENT_NAME}}"
    },
    "foundrySubscriptionId": {
      "value": "${{FOUNDRY_SUBSCRIPTION_ID}}"
    },
    "foundryResourceGroup": {
      "value": "${{FOUNDRY_RESOURCE_GROUP_NAME}}"
    },
    "foundryAccountName": {
      "value": "${{FOUNDRY_ACCOUNT_NAME}}"
    },
    "foundryProjectName": {
      "value": "${{FOUNDRY_PROJECT_NAME}}"
    }
  }
}
