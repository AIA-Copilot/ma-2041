{
  "$schema": "https://developer.microsoft.com/en-us/json-schemas/teams/v1.30/MicrosoftTeams.schema.json",
  "manifestVersion": "1.30",
  "version": "1.0.0",
  "id": "${{TEAMS_APP_ID}}",
  "developer": {
    "name": "AIA Training Lab",
    "websiteUrl": "${{LAB_WEBSITE_URL}}",
    "privacyUrl": "${{LAB_PRIVACY_URL}}",
    "termsOfUseUrl": "${{LAB_TERMS_URL}}"
  },
  "icons": {
    "color": "color.png",
    "outline": "outline.png"
  },
  "name": {
    "short": "ExpenseClaimLab",
    "full": "Lab07 ExpenseClaimAgent"
  },
  "description": {
    "short": "Simulate an expense claim with your Lab07 agent.",
    "full": "Training-only expense agent. Uses synthetic Lab07 data. No email, payment, or real expense claim is sent."
  },
  "accentColor": "#FFFFFF",
  "supportsChannelFeatures": "tier1",
  "copilotAgents": {
    "customEngineAgents": [
      {
        "type": "bot",
        "id": "${{BOT_ID}}"
      }
    ]
  },
  "bots": [
    {
      "botId": "${{BOT_ID}}",
      "scopes": [
        "personal",
        "copilot"
      ],
      "supportsFiles": false,
      "isNotificationOnly": false
    }
  ],
  "validDomains": []
}