{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Proxy only \u2014 NO provisioning",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "Build proxy (local only)",
      "program": "${workspaceFolder}/Proxy/bin/Debug/net10.0/Proxy.dll",
      "cwd": "${workspaceFolder}/Proxy",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5130"
      },
      "console": "integratedTerminal",
      "stopAtEntry": false
    }
  ]
}