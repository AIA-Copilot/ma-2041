{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build proxy (local only)",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/Proxy/Proxy.csproj"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Offline contract tests",
      "type": "process",
      "command": "dotnet",
      "args": [
        "run",
        "--project",
        "${workspaceFolder}/Tests/Tests.csproj"
      ],
      "problemMatcher": "$msCompile"
    }
  ]
}