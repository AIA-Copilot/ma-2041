{
  "openapi": "3.0.3",
  "info": { "title": "Contoso Helpdesk Ticket API", "version": "1.0.0" },
  "servers": [{ "url": "http://127.0.0.1:5000" }],
  "paths": {
    "/tickets/{ticketId}": {
      "get": {
        "operationId": "getTicket",
        "summary": "Get a single helpdesk ticket by id",
        "parameters": [
          { "name": "ticketId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Ticket found" },
          "404": { "description": "Ticket not found" }
        }
      }
    },
    "/tickets/{ticketId}/card": {
      "get": {
        "operationId": "getTicketCard",
        "summary": "Get a ticket rendered as an Adaptive Card",
        "parameters": [
          { "name": "ticketId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Adaptive Card payload" },
          "404": { "description": "Ticket not found" }
        }
      }
    }
  }
}
