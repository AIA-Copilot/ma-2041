{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Labs 2/3: ticket API (Flask, 127.0.0.1:5000)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/starters/lab2_3/app.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": false
    },
    {
      "name": "Lab 4: secured ticket API (Flask, 127.0.0.1:5001)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/starters/lab4/app.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": false
    },
    {
      "name": "Lab 5: connector dry run (plan)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/starters/lab5/connector_client.py",
      "args": [
        "plan"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": false
    },
    {
      "name": "Current lab: debug the failing test",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": [
        "-x",
        "-q",
        "${relativeFileDirname}"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": false
    }
  ]
}
