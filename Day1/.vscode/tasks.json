{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Lab 0: preflight",
      "type": "shell",
      "command": "python starters/lab0/preflight.py",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Tests: all labs (solutions)",
      "type": "shell",
      "command": "python -m pytest tests -q",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "LAB_IMPL": "solutions"
        }
      },
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "Tests: all labs (my starter code)",
      "type": "shell",
      "command": "python -m pytest tests -q",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "LAB_IMPL": "starters"
        }
      },
      "problemMatcher": []
    },
    {
      "label": "Lab 1: compile the declarative agent",
      "type": "shell",
      "command": "npx tsp compile .",
      "options": {
        "cwd": "${workspaceFolder}/starters/lab1"
      },
      "problemMatcher": []
    }
  ]
}
