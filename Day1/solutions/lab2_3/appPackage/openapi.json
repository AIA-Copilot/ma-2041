{
  "openapi": "3.0.3",
  "info": {
    "title": "Contoso Helpdesk Ticket API",
    "version": "1.0.0",
    "description": "Read-only access to Contoso helpdesk tickets for Microsoft 365 Copilot."
  },
  "servers": [
    {
      "url": "https://${{OPENAPI_SERVER_URL}}"
    }
  ],
  "paths": {
    "/tickets/{ticketId}": {
      "get": {
        "operationId": "getTicket",
        "summary": "Get a single helpdesk ticket by id",
        "description": "Returns one Contoso helpdesk ticket. Ticket ids look like T-1001.",
        "parameters": [
          {
            "name": "ticketId",
            "in": "path",
            "required": true,
            "description": "The ticket id, for example T-1001.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Ticket found",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "id",
                    "title",
                    "status",
                    "assignee_group"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "description": "Ticket id, for example T-1001."
                    },
                    "title": {
                      "type": "string"
                    },
                    "body": {
                      "type": "string"
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "open",
                        "closed"
                      ]
                    },
                    "assignee_group": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Caller could not be authenticated"
          },
          "403": {
            "description": "Caller may not read this ticket"
          },
          "404": {
            "description": "Ticket not found"
          }
        }
      }
    },
    "/tickets": {
      "get": {
        "operationId": "listTickets",
        "summary": "List helpdesk tickets the caller may read",
        "description": "Returns the tickets the caller is authorized to see. Restricted tickets are omitted.",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "required": false,
            "description": "Filter by status: open or closed.",
            "schema": {
              "type": "string",
              "enum": [
                "open",
                "closed"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Tickets the caller may read",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "value": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "id",
                          "title",
                          "status",
                          "assignee_group"
                        ],
                        "properties": {
                          "id": {
                            "type": "string",
                            "description": "Ticket id, for example T-1001."
                          },
                          "title": {
                            "type": "string"
                          },
                          "body": {
                            "type": "string"
                          },
                          "status": {
                            "type": "string",
                            "enum": [
                              "open",
                              "closed"
                            ]
                          },
                          "assignee_group": {
                            "type": "string"
                          }
                        }
                      }
                    },
                    "count": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Caller could not be authenticated"
          }
        }
      }
    }
  }
}
