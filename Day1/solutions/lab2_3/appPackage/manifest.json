{
  "$schema": "https://developer.microsoft.com/en-us/json-schemas/teams/v1.19/MicrosoftTeams.schema.json",
  "manifestVersion": "1.19",
  "version": "1.0.0",
  "id": "${{TEAMS_APP_ID}}",
  "developer": {
    "name": "Contoso IT",
    "websiteUrl": "https://www.contoso.example",
    "privacyUrl": "https://www.contoso.example/privacy",
    "termsOfUseUrl": "https://www.contoso.example/terms"
  },
  "icons": {
    "color": "color.png",
    "outline": "outline.png"
  },
  "name": {
    "short": "Support Navigator",
    "full": "Contoso Support Navigator"
  },
  "description": {
    "short": "Triage Contoso helpdesk tickets in Copilot.",
    "full": "Contoso Support Navigator helps support engineers triage tickets using Contoso's published support policies and the Contoso Helpdesk ticket API."
  },
  "accentColor": "#235A9F",
  "copilotAgents": {
    "declarativeAgents": [
      {
        "id": "ContosoSupportNavigator",
        "file": "declarative-agent.json"
      }
    ]
  },
  "permissions": [
    "identity",
    "messageTeamMembers"
  ],
  "validDomains": []
}
