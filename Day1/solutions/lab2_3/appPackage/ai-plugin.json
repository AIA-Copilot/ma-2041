{
  "$schema": "https://developer.microsoft.com/json-schemas/copilot/plugin/v2.3/schema.json",
  "schema_version": "v2.3",
  "name_for_human": "Contoso Helpdesk",
  "description_for_human": "Look up Contoso helpdesk tickets and render them as cards.",
  "description_for_model": "Use this plugin whenever the user refers to a Contoso helpdesk ticket, a ticket id in the form T-1001, or asks about the status, owner or details of a support ticket. Do not use it for general IT advice.",
  "contact_email": "support@contoso.example",
  "namespace": "contosohelpdesk",
  "capabilities": {
    "localization": {},
    "conversation_starters": [
      {
        "text": "Show me ticket T-1001"
      },
      {
        "text": "Which group owns ticket T-1003?"
      }
    ]
  },
  "functions": [
    {
      "name": "getTicket",
      "description": "Returns one Contoso helpdesk ticket by its id, for example T-1001.",
      "capabilities": {
        "response_semantics": {
          "data_path": "$",
          "properties": {
            "title": "$.title",
            "subtitle": "$.status"
          },
          "static_template": {
            "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
            "type": "AdaptiveCard",
            "version": "1.5",
            "body": [
              {
                "type": "TextBlock",
                "text": "${id} - ${title}",
                "weight": "Bolder",
                "size": "Medium",
                "wrap": true
              },
              {
                "type": "FactSet",
                "facts": [
                  {
                    "title": "Status",
                    "value": "${status}"
                  },
                  {
                    "title": "Owning group",
                    "value": "${assignee_group}"
                  }
                ]
              },
              {
                "type": "TextBlock",
                "text": "${body}",
                "wrap": true,
                "isSubtle": true
              }
            ]
          }
        },
        "security_info": {
          "data_handling": [
            "GetPrivateData"
          ]
        }
      },
      "states": {
        "reasoning": {
          "description": "Call this when the user names or implies a specific ticket id.",
          "instructions": [
            "Extract the ticket id from the user's message. Ticket ids look like T-1001.",
            "If no ticket id is present, ask the user for one instead of guessing."
          ]
        },
        "responding": {
          "description": "Summarise the ticket for a support engineer.",
          "instructions": [
            "Lead with the ticket id, title and status.",
            "Name the owning group so the engineer knows where to route it.",
            "Never invent fields that are not in the response."
          ]
        }
      }
    },
    {
      "name": "listTickets",
      "description": "Lists Contoso helpdesk tickets the signed-in caller is allowed to read.",
      "capabilities": {
        "response_semantics": {
          "data_path": "$.value",
          "properties": {
            "title": "$.title",
            "subtitle": "$.status"
          },
          "static_template": {
            "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
            "type": "AdaptiveCard",
            "version": "1.5",
            "body": [
              {
                "type": "TextBlock",
                "text": "${id} - ${title}",
                "weight": "Bolder",
                "wrap": true
              },
              {
                "type": "TextBlock",
                "text": "Status: ${status} | Group: ${assignee_group}",
                "wrap": true,
                "isSubtle": true
              }
            ]
          }
        },
        "security_info": {
          "data_handling": [
            "GetPrivateData"
          ]
        }
      }
    }
  ],
  "runtimes": [
    {
      "type": "OpenApi",
      "auth": {
        "type": "None"
      },
      "spec": {
        "url": "openapi.json",
        "progress_style": "ShowUsageWithInputAndOutput"
      },
      "run_for_functions": [
        "getTicket",
        "listTickets"
      ]
    }
  ]
}
