{
  "name": "nodejs-typescript-policies",
  "version": "1.0.0",
  "description": "## Build a basic declarative copilot",
  "module": "esnext",
  "main": "dist/src/functions/*.js",
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "prestart": "npm run clean && npm run build",
    "start": "node scripts/run-func.cjs start",
    "test": "node --test tests/*.test.cjs",
    "storage": "azurite --disableTelemetry --silent --location ./_storage_emulator --debug ./_storage_emulator/debug.log",
    "prettier:check": "prettier --check \"./src/**/*.{ts,json}\"",
    "prettier:write": "prettier --write \"./src/**/*.{ts,json}\"",
    "notify:admin-consent": "node ./scripts/admin-consent.js",
    "check:func": "node scripts/run-func.cjs --version"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@azure/functions": "^4.5.0",
    "@azure/identity": "4.4.1",
    "@microsoft/microsoft-graph-client": "^3.0.7",
    "dotenv": "^16.4.5",
    "gray-matter": "^4.0.3",
    "remove-markdown": "^0.5.2"
  },
  "devDependencies": {
    "@microsoft/microsoft-graph-types": "^2.40.0",
    "@types/node": "22.20.5",
    "azurite": "3.38.0",
    "minimist": "^1.2.8",
    "ts-node": "^10.9.2",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.12.0 <23"
  }
}
