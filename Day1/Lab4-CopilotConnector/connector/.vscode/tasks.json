{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "TTK",
      "dependsOn": [
        "Verify approved Core Tools",
        "Install Dependencies",
        "Start Azurite emulator",
        "Provision"
      ],
      "dependsOrder": "sequence"
    },
    {
      "type": "shell",
      "label": "Install Dependencies",
      "command": "npm ci --ignore-scripts --no-audit",
      "windows": {
        "command": "npm.cmd ci --ignore-scripts --no-audit"
      }
    },
    {
      "type": "shell",
      "label": "Run watch",
      "command": "npm run watch",
      "isBackground": true,
      "problemMatcher": "$tsc-watch",
      "windows": {
        "command": "npm.cmd run watch"
      }
    },
    {
      "label": "Start Azurite emulator",
      "type": "shell",
      "command": "npm run storage",
      "isBackground": true,
      "problemMatcher": {
        "pattern": [
          {
            "regexp": "^.*$",
            "file": 0,
            "location": 1,
            "message": 2
          }
        ],
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Azurite",
          "endsPattern": "successfully listening"
        }
      },
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "windows": {
        "command": "npm.cmd run storage"
      }
    },
    {
      "label": "Provision",
      "type": "teamsfx",
      "command": "provision",
      "args": {
        "env": "local"
      }
    },
    {
      "label": "Terminate All Tasks",
      "command": "echo ${input:terminate}",
      "type": "shell",
      "problemMatcher": []
    },
    {
      "type": "shell",
      "label": "func: host start",
      "command": "node scripts/run-func.cjs start --language-worker=\"--inspect=9229\"",
      "problemMatcher": "$func-node-watch",
      "isBackground": true,
      "dependsOn": "npm watch (functions)",
      "windows": {
        "command": "node scripts/run-func.cjs start --language-worker=\"--inspect=9229\""
      }
    },
    {
      "type": "shell",
      "label": "npm build (functions)",
      "command": "npm run build",
      "dependsOn": "npm clean (functions)",
      "problemMatcher": "$tsc",
      "windows": {
        "command": "npm.cmd run build"
      }
    },
    {
      "type": "shell",
      "label": "npm watch (functions)",
      "command": "npm run watch",
      "dependsOn": "npm clean (functions)",
      "problemMatcher": "$tsc-watch",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "isBackground": true,
      "windows": {
        "command": "npm.cmd run watch"
      }
    },
    {
      "type": "shell",
      "label": "npm install (functions)",
      "command": "npm ci --ignore-scripts --no-audit",
      "windows": {
        "command": "npm.cmd ci --ignore-scripts --no-audit"
      }
    },
    {
      "type": "shell",
      "label": "npm prune (functions)",
      "command": "npm prune --production",
      "dependsOn": "npm build (functions)",
      "problemMatcher": [],
      "windows": {
        "command": "npm.cmd prune --production"
      }
    },
    {
      "type": "shell",
      "label": "npm clean (functions)",
      "command": "npm run clean",
      "windows": {
        "command": "npm.cmd run clean"
      }
    },
    {
      "label": "Verify approved Core Tools",
      "type": "shell",
      "command": "npm run check:func",
      "windows": {
        "command": "npm.cmd run check:func"
      },
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "terminate",
      "type": "command",
      "command": "workbench.action.tasks.terminate",
      "args": "terminateAll"
    }
  ]
}
